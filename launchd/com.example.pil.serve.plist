<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 示例 plist：把 __PROJECT_ROOT__ / __PIL_HOME__ 换成你的绝对路径，按需改 Label 前缀，再复制到 ~/Library/LaunchAgents/。 -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.example.pil.serve</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_ROOT__/.venv/bin/pil</string>
        <string>serve</string>
        <string>--host</string>
        <string>127.0.0.1</string>
        <string>--port</string>
        <string>8766</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__PIL_HOME__/logs/launchd_serve.out</string>
    <key>StandardErrorPath</key>
    <string>__PIL_HOME__/logs/launchd_serve.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>__PROJECT_ROOT__/.venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PIL_HOME</key>
        <string>__PIL_HOME__</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>
</dict>
</plist>
